<Page x:Class="Diplom.Pages.Search"
      
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom.Pages"
      mc:Ignorable="d" 
       d:DesignHeight="800" d:DesignWidth="1500"
      Title="Search">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBox x:Name ="TxbSearch" Width="400" Height="50" Margin="30"/>
            <Button x:Name="BtnSearch" Content="Поиск" Width="100" Click="Search_Click"/>
            <TextBlock Text="Выберите тип:" FontSize="25" TextWrapping="WrapWithOverflow" Width="170" Height="40" Margin ="80,0,0,0"/>
            <ComboBox x:Name="CmbTypeSight"  Width="250" Height="50" ItemsSource="{Binding TypeSight.Name}"/>
            <Button x:Name="BtnCancel" Content="Сбросить фильтр" Width="180" Margin="10" Click="Refresh_Click"/>
        </StackPanel>
        <ListView Grid.Row="1" x:Name="LstSight" ItemsSource="{Binding KazanSight}" MouseDoubleClick="Info_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Image Source="{Binding Image}" Width="150" Height="150"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding Description}"/>  <!--переделать на краткое описание-->
                        </StackPanel>
                        
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
